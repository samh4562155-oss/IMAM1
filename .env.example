DEEPGRAM_API_KEY=your_deepgram_api_key_here
PORT=3000
# Extra web origins allowed to call the API (comma-separated). The Android app origin is always allowed.
ALLOWED_ORIGINS=
# Max Deepgram tokens per device/IP every 10 minutes.
TOKEN_RATE_LIMIT=20
# Used only when building the Android app: your hosted HTTPS server address (not a secret).
IMAM_API_BASE=https://your-imam-server.example.com
